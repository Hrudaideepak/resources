# --- Database (optional; without these the app runs on bundled seed data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: profile/auth + moderation writes (bypasses RLS). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# REQUIRED in production. min 32 random chars (e.g. `openssl rand -hex 32`).
# A documented insecure fallback is used in dev when unset.
JWT_SECRET=
# Comma-separated hall tickets that get admin rights (moderation, discovery):
# ADMIN_HALL_TICKETS=22A81A0501,22A81A0502
ADMIN_HALL_TICKETS=

# --- AI assistant (optional) ---
# Without it, /api/ai/ask returns an honest offline summary from the syllabus.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Discovery agent (optional; needs outbound network) ---
# Without it, YouTube results fall back to a best-effort scrape.
YOUTUBE_API_KEY=
